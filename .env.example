DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
JWT_SECRET=
PORT=3000
# Optional override. Same-port custom server defaults to window.location.origin
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Optional production Socket.IO CORS origin (defaults to false / same-origin only)
# SOCKET_CORS_ORIGIN=https://your-domain.com

# Message archival (cron wired in server.js only — not next dev)
# Cutoff age in ms before a live message is archived (default 24h).
# For local tests use e.g. 120000 (2 min) or 300000 (5 min).
# MESSAGE_ARCHIVE_CUTOFF_MS=86400000
# MESSAGE_ARCHIVE_BATCH_SIZE=1000
# MESSAGE_ARCHIVE_CRON=0 3 * * *
# MESSAGE_ARCHIVE_TZ=Asia/Kolkata
# Manual: npm run archive:once
